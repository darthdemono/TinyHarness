import sys

from tinyharness.agent import Agent
from tinyharness.client import Client
from tinyharness.extras import extras
from tinyharness.web import make_server

SYSTEM = "TODO: say who the assistant helps and how it should answer."


def build_agent(client=None):
    """Create the assistant. Add your own tools with `agent.tool` or `agent.add_tools`."""
    agent = Agent(client or Client(), system=SYSTEM)
    agent.add_tools(extras())  # calculator, clock, web page text
    return agent


def main(argv):
    if argv[:1] == ["serve"]:
        server = make_server(build_agent, port=8080)
        print("http://127.0.0.1:8080")
        server.serve_forever()
        return 0
    build_agent().run(" ".join(argv) or "Say hello.", on_token=lambda t: print(t, end="", flush=True))
    print()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
